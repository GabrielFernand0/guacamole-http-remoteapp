#!/bin/bash
set -e

URL="${1:-}"
[ -r /etc/xrdp/xrdp-env ] && . /etc/xrdp/xrdp-env
URL="${URL:-${DEFAULT_URL:-about:blank}}"

case "$URL" in
    http://*|https://*|about:blank) ;;
    *)
        echo "Only HTTP, HTTPS, and about:blank URLs are supported." >&2
        exit 2
        ;;
esac

PROFILE_DIR="$(mktemp -d -t firefox-session-XXXXXXXX)"
WM_PID=""
DBUS_SESSION_BUS_PID=""
cleanup() {
    [ -n "$WM_PID" ] && kill "$WM_PID" 2>/dev/null || true
    [ -n "$DBUS_SESSION_BUS_PID" ] && kill "$DBUS_SESSION_BUS_PID" 2>/dev/null || true
    rm -rf "$PROFILE_DIR"
}
trap cleanup EXIT

if command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax)"
    export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
fi

openbox &
WM_PID=$!
sleep 0.3
if firefox-esr --no-remote --profile "$PROFILE_DIR" --kiosk "$URL"; then
    STATUS=0
else
    STATUS=$?
fi
exit "$STATUS"
